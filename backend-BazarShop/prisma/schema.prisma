// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}




// =========================
// ENUMS
// =========================

enum Role {
  ADMIN
  UTILISATEUR
}

enum StatutCompte {
  ACTIF
  SUSPENDU
  SUPPRIME
}

enum StatutAnnonce {
  ACTIVE
  VENDUE
  REFUSEE
}

enum TypeAnnonce {
  VENTE
  TROC
  VENTE_ET_TROC
}

enum TypeCibleSignalement {
  ANNONCE
  UTILISATEUR
}

enum StatutSignalement {
  EN_ATTENTE
  EN_COURS
  TRAITE
  REJETE
}

// =========================
// UTILISATEUR
// =========================

model Utilisateur {
  id_utilisateur  String         @id @default(uuid()) @db.VarChar(36)
  nom             String      @db.VarChar(100)
  prenom          String      @db.VarChar(100)
  email           String      @unique @db.VarChar(191)
  telephone       String?      @db.VarChar(20)
  mot_de_passe    String      @db.VarChar(255)
  date_inscription DateTime   @default(now()) @db.DateTime(0)
  role            Role        @default(UTILISATEUR)
  statut_compte   StatutCompte @default(ACTIF)

  annonces              Annonce[]
  favoris               Favori[]
  participations        ConversationParticipant[]
  messages              Message[]
  refreshTokens         RefreshToken[]

  avisDonnes            Avis[] @relation("AvisAuteur")
  avisRecus             Avis[] @relation("AvisDestinataire")

  signalementsCrees     Signalement[] @relation("SignalementAuteur")
  signalementsRecus     Signalement[] @relation("UtilisateurSignale")

  propositionsEnvoyees  PropositionTroc[] @relation("PropositionEmetteur")
  propositionsRecues    PropositionTroc[] @relation("PropositionReceveur")

  @@map("Utilisateur")
}

// =========================
// ANNONCE
// =========================

model Annonce {
  id_annonce        String           @id @default(uuid()) @db.VarChar(36)
  titre             String        @db.VarChar(150)
  description       String        @db.Text
  prix              Decimal?      @db.Decimal(12, 2)
  localisation      String        @db.VarChar(191)
  type              TypeAnnonce   @default(VENTE)
  statut            StatutAnnonce @default(ACTIVE)
  date_publication  DateTime      @default(now()) @db.DateTime(0)
  date_modification DateTime      @updatedAt @db.DateTime(0)

  id_utilisateur    String           @db.VarChar(36)  
  proprietaire      Utilisateur   @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Restrict)

  photos            Photo[]
  favoris           Favori[]
  categories        AnnonceCategorie[]
  signalements      Signalement[]
  propositions      PropositionTroc[]

  @@index([id_utilisateur])
  @@index([statut, date_publication])
  @@index([type])
  @@map("Annonce")
}

// =========================
// CATEGORIES
// =========================

model Categorie {
  id_categorie Int       @id @default(autoincrement()) @db.UnsignedInt
  nom          String    @unique @db.VarChar(100)
  description  String?   @db.Text

  annonces AnnonceCategorie[]

  @@map("Categorie")
}

// Table d'association N:N entre Annonce et Categorie
model AnnonceCategorie {
  id_annonce   String   @db.VarChar(36)
  id_categorie Int      @db.UnsignedInt

  annonce   Annonce   @relation(fields: [id_annonce], references: [id_annonce], onDelete: Cascade)
  categorie Categorie @relation(fields: [id_categorie], references: [id_categorie], onDelete: Cascade)

  @@id([id_annonce, id_categorie])
  @@index([id_categorie])
  @@map("AnnonceCategorie")
}

// =========================
// PHOTOS
// =========================

model Photo {
  id_photo       Int      @id @default(autoincrement()) @db.UnsignedInt
  url            String   @db.VarChar(2048)
  nom_fichier    String?  @db.VarChar(255)
  ordre          Int      @default(0) @db.UnsignedSmallInt
  est_principale Boolean  @default(false)

  id_annonce String     @db.VarChar(36) 
  annonce    Annonce @relation(fields: [id_annonce], references: [id_annonce], onDelete: Cascade)

  @@unique([id_annonce, ordre])
  @@index([id_annonce, est_principale])
  @@map("Photo")
}

// =========================
// FAVORIS
// =========================

model Favori {
  id_utilisateur  String       @db.VarChar(36)  
  id_annonce     String        @db.VarChar(36)
  date_ajout     DateTime   @default(now()) @db.DateTime(0)

  utilisateur Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  annonce     Annonce     @relation(fields: [id_annonce], references: [id_annonce], onDelete: Cascade)

  // Empêche un utilisateur d'ajouter deux fois la même annonce
  @@id([id_utilisateur, id_annonce])
  @@index([id_annonce])
  @@map("Favori")
}

// =========================
// CONVERSATIONS
// =========================

model Conversation {
  id_conversation Int      @id @default(autoincrement()) @db.UnsignedInt
  date_creation   DateTime @default(now()) @db.DateTime(0)

  participants ConversationParticipant[]
  messages     Message[]

  @@map("Conversation")
}

// Association N:N entre utilisateurs et conversations
model ConversationParticipant {
  id_conversation Int      @db.UnsignedInt
  id_utilisateur  String      @db.VarChar(36)
  date_lecture    DateTime? @db.DateTime(0)

  conversation Conversation @relation(fields: [id_conversation], references: [id_conversation], onDelete: Cascade)
  utilisateur  Utilisateur  @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)

  @@id([id_conversation, id_utilisateur])
  @@index([id_utilisateur])
  @@map("ConversationParticipant")
}

// =========================
// MESSAGES
// =========================

model Message {
  id_message      Int      @id @default(autoincrement()) @db.UnsignedInt
  contenu         String   @db.Text
  date_envoi      DateTime @default(now()) @db.DateTime(0)
  est_lu          Boolean  @default(false)

  id_conversation Int      @db.UnsignedInt
  id_expediteur   String   @db.VarChar(36)

  conversation Conversation @relation(fields: [id_conversation], references: [id_conversation], onDelete: Cascade)
  expediteur   Utilisateur  @relation(fields: [id_expediteur], references: [id_utilisateur], onDelete: Restrict)

  @@index([id_conversation, date_envoi])
  @@index([id_expediteur])
  @@map("Message")
}

// =========================
// REFRESH TOKENS
// =========================

model RefreshToken {
  id_refresh_token Int       @id @default(autoincrement()) @db.UnsignedInt
  token_hash       String    @unique @db.VarChar(255)
  date_creation    DateTime  @default(now()) @db.DateTime(0)
  date_expiration  DateTime  @db.DateTime(0)
  date_revocation  DateTime? @db.DateTime(0)

  id_utilisateur String      @db.VarChar(36)
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)

  @@index([id_utilisateur])
  @@index([date_expiration])
  @@map("RefreshToken")
}

// =========================
// AVIS
// =========================

model Avis {
  id_avis           Int      @id @default(autoincrement()) @db.UnsignedInt
  note              Int      @db.UnsignedTinyInt
  commentaire       String?  @db.Text
  date_creation     DateTime @default(now()) @db.DateTime(0)

  id_auteur         String   @db.VarChar(36)
  id_destinataire   String   @db.VarChar(36)

  auteur       Utilisateur @relation("AvisAuteur", fields: [id_auteur], references: [id_utilisateur], onDelete: Restrict)
  destinataire Utilisateur @relation("AvisDestinataire", fields: [id_destinataire], references: [id_utilisateur], onDelete: Restrict)

  @@index([id_destinataire, date_creation])
  @@index([id_auteur])
  @@map("Avis")
}

// =========================
// SIGNALEMENTS
// =========================

model Signalement {
  id_signalement Int                 @id @default(autoincrement()) @db.UnsignedInt
  motif          String              @db.VarChar(255)
  description    String?             @db.Text
  type_cible     TypeCibleSignalement
  statut         StatutSignalement   @default(EN_ATTENTE)
  date_creation  DateTime            @default(now()) @db.DateTime(0)

  id_auteur             String  @db.VarChar(36)
  id_annonce            String? @db.VarChar(36)
  id_utilisateur_signale String? @db.VarChar(36)

  auteur             Utilisateur  @relation("SignalementAuteur", fields: [id_auteur], references: [id_utilisateur], onDelete: Restrict)
  annonce            Annonce?     @relation(fields: [id_annonce], references: [id_annonce], onDelete: Restrict)
  utilisateur_signale Utilisateur? @relation("UtilisateurSignale", fields: [id_utilisateur_signale], references: [id_utilisateur], onDelete: Restrict)

  @@index([statut, date_creation])
  @@index([id_annonce])
  @@index([id_utilisateur_signale])
  @@map("Signalement")
}

// =========================
// PROPOSITIONS DE TROC
// =========================

model PropositionTroc {
  id_proposition  Int      @id @default(autoincrement()) @db.UnsignedInt
  description     String?  @db.Text
  statut          StatutPropositionTroc @default(EN_ATTENTE)
  date_creation   DateTime @default(now()) @db.DateTime(0)
  date_modification DateTime @updatedAt @db.DateTime(0)

  id_annonce_cible String     @db.VarChar(36)
  id_emetteur      String     @db.VarChar(36)
  id_receveur      String     @db.VarChar(36)

  annonce_cible Annonce     @relation(fields: [id_annonce_cible], references: [id_annonce], onDelete: Restrict)
  emetteur      Utilisateur @relation("PropositionEmetteur", fields: [id_emetteur], references: [id_utilisateur], onDelete: Restrict)
  receveur      Utilisateur @relation("PropositionReceveur", fields: [id_receveur], references: [id_utilisateur], onDelete: Restrict)

  @@index([id_annonce_cible, statut])
  @@index([id_emetteur])
  @@index([id_receveur])
  @@map("PropositionTroc")
}

enum StatutPropositionTroc {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
  ANNULEE
}

